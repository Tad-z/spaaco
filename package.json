{
  "name": "spa-ajibade-api",
  "version": "0.1.0",
  "private": true,
  "description": "Content and admin API for the SPA Ajibade & Co. website",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/bundle-spec.mjs openapi",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-spec.mjs dist/openapi",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "types:gen": "openapi-typescript openapi/openapi.yaml -o src/types/api.generated.ts",
    "types:check": "node scripts/check-generated-types.mjs",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:sync-indexes": "tsx --env-file-if-exists=.env scripts/sync-indexes.ts",
    "load-launch-content": "tsx --env-file-if-exists=.env scripts/load-launch-content.ts",
    "publish-all": "tsx --env-file-if-exists=.env scripts/publish-all.ts",
    "upload-images": "tsx --env-file-if-exists=.env scripts/upload-images.ts",
    "rebuild-image-sizes": "tsx --env-file-if-exists=.env scripts/rebuild-image-sizes.ts",
    "mock": "prism mock openapi/openapi.yaml -p 4010",
    "spec:lint": "redocly lint openapi/openapi.yaml",
    "docs": "redocly preview-docs openapi/openapi.yaml",
    "docs:bundle": "node scripts/bundle-spec.mjs openapi",
    "docs:build": "redocly build-docs openapi/openapi.yaml -o dist-docs/index.html",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run spec:lint && npm run types:check && npm test",
    "spec:gen": "tsx scripts/generate-admin-content-spec.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^1.34.20",
    "@stoplight/prism-cli": "^5.15.11",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.4.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
